{
  "manifest_version": 3,
  "name": "简历填写工具",
  "version": "1.5.21",
  "description": "本地存储简历资料，模糊匹配 + 可选 AI 巡查/填写求职表单。数据默认仅本机；启用 AI 时才发送非空字段到你配置的接口。提交前由您确认。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "简历填写工具",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/match.js",
        "shared/date-capability.js",
        "shared/date-strategies.js",
        "shared/audit.js",
        "shared/select-chain.js",
        "content/autofill.js",
        "content/panel.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "shared/*",
        "demo/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
