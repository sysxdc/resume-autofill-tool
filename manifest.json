{
  "manifest_version": 3,
  "name": "简历填写工具",
  "version": "1.8.1",
  "description": "本地存储简历资料，匹配并填写求职表单。AI 默认只发送字段标签；全文模式需显式开启。提交前由您确认。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "简历填写工具",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/match.js",
        "shared/date-capability.js",
        "shared/date-strategies.js",
        "shared/audit.js",
        "shared/select-chain.js",
        "content/fill/recognize.js",
        "content/fill/write.js",
        "content/fill/sections.js",
        "content/fill/aria-select.js",
        "content/fill/select.js",
        "content/fill/dates.js",
        "content/sites/antd-date.js",
        "content/sites/laydate.js",
        "content/fill/ranges.js",
        "content/sites/phoenix.js",
        "content/fill/radios.js",
        "content/autofill.js",
        "content/panel.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/page-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "shared/*",
        "demo/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "minimum_chrome_version": "111"
}
