{
  "name": "resume-autofill-tool",
  "version": "1.9.0",
  "private": true,
  "description": "Chrome MV3 resume autofill extension — local profile + fuzzy match + optional AI",
  "scripts": {
    "test": "node tests/run-tests.mjs",
    "test:unit": "node tests/run-tests.mjs",
    "test:dom": "node tests/run-dom-tests.mjs",
    "test:parser": "node tests/resume-parser.test.mjs",
    "test:safety": "node --test tests/field-safety.test.mjs",
    "test:profile": "node --test tests/profile-quality.test.mjs",
    "test:benchmark": "node tests/match-benchmark.mjs",
    "test:real": "node tests/real/run-real.mjs",
    "verify:release": "node tests/release.mjs",
    "release": "node tests/release.mjs --package"
  },
  "devDependencies": {
    "playwright": "^1.55.0"
  },
  "engines": {
    "node": ">=18"
  }
}
